# ==============================================================================
# Phase 0 Spike: Containerfile
# 
# 目的: Spike-02（実行隔離）および Spike-11（認証受け渡し）で利用する
#       コンテナ環境の定義。
# 前提: ホストの agy 単体バイナリを組み込み、最小限の依存パッケージのみ導入する。
#       認証情報、~/.gemini の内容、設定ファイルは一切イメージに含めない。
# ビルド例:
#   spike/phase0/build-image.sh を実行してビルドする
# ==============================================================================

# 1. ベースイメージの定義
# TODO: Humanが指定（例: registry.fedoraproject.org/fedora:40 等）
ARG BASE_IMAGE="registry.fedoraproject.org/fedora:TODO"
FROM ${BASE_IMAGE}

# 2. 基本ツール・依存パッケージの導入（指定されたパッケージのみ）
RUN dnf install -y git procps-ng which findutils ca-certificates && dnf clean all

# 3. AGY CLI の配置
ARG AGY_VERSION="unknown"
LABEL org.novui.agy.version="${AGY_VERSION}"

# ビルド用ディレクトリに置かれたホストの agy バイナリを配置
COPY agy /usr/local/bin/agy
RUN chmod 0755 /usr/local/bin/agy

# 自動更新に関する設定
# TODO: Spike-00の--help出力で自動更新の無効化方法を確認

# 4. 作業用ディレクトリの準備
WORKDIR /workspace

# 5. 実行ユーザーと環境設定
# rootless Podman (--userns=keep-id) で任意のUIDが書き込めるよう権限を設定
RUN mkdir -p /home/agy && chmod 0777 /home/agy
ENV HOME=/home/agy
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# デフォルトのシェルコマンド
CMD ["/bin/sh"]
