{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NovUIChapterPlan",
  "description": "Simplified chapter plan schema for Spike-05 verification",
  "type": "object",
  "properties": {
    "chapter_id": {
      "type": "string",
      "pattern": "^ch-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "target_word_count": {
      "type": "integer",
      "minimum": 1000
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "scene_number": {
            "type": "integer"
          },
          "summary": {
            "type": "string"
          },
          "characters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "goal": {
            "type": "string"
          }
        },
        "required": [
          "scene_number",
          "summary",
          "characters",
          "goal"
        ],
        "additionalProperties": false
      }
    },
    "foreshadowing_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "introduce",
              "advance",
              "resolve",
              "none"
            ]
          }
        },
        "required": [
          "id",
          "action"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "chapter_id",
    "title",
    "target_word_count",
    "scenes"
  ],
  "additionalProperties": false
}
