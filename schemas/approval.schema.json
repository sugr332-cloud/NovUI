{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novui.local/schemas/approval.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "approval_id": { "$ref": "common.schema.json#/$defs/approval_id" },
    "source": {
      "type": "string",
      "enum": ["instruction", "proposal"]
    },
    "instruction_id": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/instruction_id" },
        { "type": "null" }
      ]
    },
    "job_id": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/job_id" },
        { "type": "null" }
      ]
    },
    "patch_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/relpath" }
    },
    "approved_by": { "const": "human" },
    "approved_at": { "$ref": "common.schema.json#/$defs/datetime" }
  },
  "required": [
    "approval_id",
    "source",
    "instruction_id",
    "job_id",
    "patch_sha256",
    "targets",
    "approved_by",
    "approved_at"
  ]
}
