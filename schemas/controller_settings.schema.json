{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novui.local/schemas/controller_settings.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "draft": { "$ref": "common.schema.json#/$defs/nonempty_string" },
        "range_edit": { "$ref": "common.schema.json#/$defs/nonempty_string" },
        "chapter_rewrite": { "$ref": "common.schema.json#/$defs/nonempty_string" }
      }
    },
    "works": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9][a-z0-9-]{0,63}$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "models": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "draft": { "$ref": "common.schema.json#/$defs/nonempty_string" },
                "range_edit": { "$ref": "common.schema.json#/$defs/nonempty_string" },
                "chapter_rewrite": { "$ref": "common.schema.json#/$defs/nonempty_string" }
              }
            }
          },
          "required": ["models"]
        }
      }
    }
  },
  "required": [
    "models",
    "works"
  ]
}
