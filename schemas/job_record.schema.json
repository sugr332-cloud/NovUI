{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novui.local/schemas/job_record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "job_id": { "$ref": "common.schema.json#/$defs/job_id" },
    "job_type": { "$ref": "common.schema.json#/$defs/job_type" },
    "chapter_id": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/chapter_id" },
        { "type": "null" }
      ]
    },
    "state": { "$ref": "common.schema.json#/$defs/job_state" },
    "created_at": { "$ref": "common.schema.json#/$defs/datetime" },
    "started_at": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/datetime" },
        { "type": "null" }
      ]
    },
    "finished_at": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/datetime" },
        { "type": "null" }
      ]
    },
    "base_commit": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/commit" },
        { "type": "null" }
      ]
    },
    "branch": { "type": ["string", "null"] },
    "worktree": { "type": ["string", "null"] },
    "instruction_id": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/instruction_id" },
        { "type": "null" }
      ]
    },
    "approval_id": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/approval_id" },
        { "type": "null" }
      ]
    },
    "context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": { "$ref": "common.schema.json#/$defs/relpath" },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        },
        "required": ["path", "sha256"]
      }
    },
    "cli": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "enum": ["agy", "claude"]
            },
            "version": { "$ref": "common.schema.json#/$defs/nonempty_string" },
            "model": { "$ref": "common.schema.json#/$defs/nonempty_string" }
          },
          "required": ["name", "version", "model"]
        }
      ]
    },
    "container": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image_tag": { "$ref": "common.schema.json#/$defs/nonempty_string" },
            "image_id": { "$ref": "common.schema.json#/$defs/nonempty_string" }
          },
          "required": ["image_tag", "image_id"]
        }
      ]
    },
    "run": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "exit_code": { "type": ["integer", "null"] },
            "elapsed_seconds": { "type": "number", "minimum": 0 },
            "timed_out": { "type": "boolean" },
            "signal": {
              "type": ["string", "null"],
              "enum": ["SIGTERM", "SIGKILL", null]
            },
            "timeout_seconds": { "type": "integer", "minimum": 1 }
          },
          "required": [
            "exit_code",
            "elapsed_seconds",
            "timed_out",
            "signal",
            "timeout_seconds"
          ]
        }
      ]
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/check_result" }
    },
    "attempt": { "type": "integer", "minimum": 1 },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "state": { "$ref": "common.schema.json#/$defs/job_state" },
          "event": { "type": ["string", "null"] },
          "at": { "$ref": "common.schema.json#/$defs/datetime" },
          "reason": { "type": ["string", "null"] }
        },
        "required": ["state", "event", "at", "reason"]
      }
    }
  },
  "required": [
    "job_id",
    "job_type",
    "chapter_id",
    "state",
    "created_at",
    "started_at",
    "finished_at",
    "base_commit",
    "branch",
    "worktree",
    "instruction_id",
    "approval_id",
    "context",
    "cli",
    "container",
    "run",
    "checks",
    "attempt",
    "history"
  ]
}
