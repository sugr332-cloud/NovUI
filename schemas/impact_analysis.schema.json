{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novui.local/schemas/impact_analysis.schema.json",
  "description": "Chapters affected by a setting change (phase3b-design §3.1)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": { "const": "impact_analysis" },
    "affected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "chapter_id": { "$ref": "common.schema.json#/$defs/chapter_id" },
          "reason": { "$ref": "common.schema.json#/$defs/nonempty_string" }
        },
        "required": ["chapter_id", "reason"]
      }
    },
    "notes": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/nonempty_string" }
    }
  },
  "required": ["type", "affected", "notes"]
}
