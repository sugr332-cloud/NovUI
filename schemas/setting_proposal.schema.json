{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novui.local/schemas/setting_proposal.schema.json",
  "description": "A setting_change proposal kept in Controller data until the Human decides (phase3b-design §3.3)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": { "const": "setting_proposal" },
    "instruction_id": { "$ref": "common.schema.json#/$defs/instruction_id" },
    "job_id": { "$ref": "common.schema.json#/$defs/job_id" },
    "instruction": { "$ref": "common.schema.json#/$defs/nonempty_string" },
    "base_commit": { "$ref": "common.schema.json#/$defs/commit" },
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": { "$ref": "common.schema.json#/$defs/relpath" },
          "change": { "$ref": "common.schema.json#/$defs/nonempty_string" }
        },
        "required": ["target", "change"]
      }
    },
    "patches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "patch": { "$ref": "state_patch.schema.json" },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        },
        "required": ["patch", "sha256"]
      }
    },
    "impact": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "chapter_id": { "$ref": "common.schema.json#/$defs/chapter_id" },
          "reason": { "$ref": "common.schema.json#/$defs/nonempty_string" }
        },
        "required": ["chapter_id", "reason"]
      }
    },
    "impact_notes": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/nonempty_string" }
    },
    "status": {
      "type": "string",
      "enum": ["pending", "approved", "rejected", "superseded", "invalid"]
    },
    "status_reason": { "type": ["string", "null"] },
    "created_at": { "$ref": "common.schema.json#/$defs/datetime" },
    "decided_at": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/datetime" },
        { "type": "null" }
      ]
    },
    "approval_id": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/approval_id" },
        { "type": "null" }
      ]
    },
    "commit": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/commit" },
        { "type": "null" }
      ]
    }
  },
  "required": [
    "type", "instruction_id", "job_id", "instruction", "base_commit", "plan", "patches", "impact",
    "impact_notes", "status", "status_reason", "created_at", "decided_at", "approval_id", "commit"
  ]
}
