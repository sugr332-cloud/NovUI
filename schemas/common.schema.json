{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novui.local/schemas/common.schema.json",
  "$defs": {
    "chapter_id": {
      "type": "string",
      "pattern": "^ch-[0-9]{3,}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^job-[0-9]+$"
    },
    "instruction_id": {
      "type": "string",
      "pattern": "^INS-[0-9]{4,}$"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^A-[0-9]{4,}$"
    },
    "character_id": {
      "type": "string",
      "pattern": "^C[0-9]{3,}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "datetime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "relpath": {
      "type": "string",
      "minLength": 1
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "type": "string",
      "enum": ["PASS", "WARNING", "STOP"]
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "$ref": "#/$defs/nonempty_string" },
        "before": { "type": "string" },
        "after": { "type": "string" }
      },
      "required": ["text", "before", "after"]
    },
    "check_result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/nonempty_string" },
        "status": {
          "type": "string",
          "enum": ["PASS", "WARNING", "FAIL"]
        },
        "details": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["name", "status", "details"]
    },
    "chapter_state": {
      "type": "string",
      "enum": [
        "OUTLINED",
        "PLANNED",
        "PLAN_APPROVED",
        "DRAFTED",
        "AI_VALIDATED",
        "HUMAN_APPROVED",
        "FINAL"
      ]
    },
    "job_state": {
      "type": "string",
      "enum": [
        "QUEUED",
        "RUNNING",
        "CHECKING",
        "VALIDATING",
        "WAITING_HUMAN",
        "COMPLETED",
        "FAILED",
        "STOPPED",
        "CANCELLED"
      ]
    },
    "job_type": {
      "type": "string",
      "enum": [
        "plan",
        "draft",
        "range_edit",
        "chapter_rewrite",
        "plan_revision",
        "validate",
        "state_update",
        "setting_change",
        "resolve_request",
        "routing"
      ]
    }
  }
}
